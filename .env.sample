# Anna Nova — bouwplan v2 config
# Kopieer naar `.env` (installer doet dat de eerste keer).

# -------------------------------------------------------------
# DROOGLOOP — bouwdag-ontwikkeling zonder mic/scherm/printer
# -------------------------------------------------------------
# DROOGLOOP=1 → hear.py leest stdin, speak.py print, printer.py saves PNG
# DROOGLOOP=0 → echte mic / audio / printer (bouwstap 6+ nodig)
DROOGLOOP=0

# Snelheids-factor voor droogloop-speak (sleep = _duur * factor)
# 0.0 = instant, 0.2 = snel-zichtbaar, 1.0 = realtime
DROOGLOOP_SIM=0.2

# -------------------------------------------------------------
# BREIN — Mistral JSON-call
# -------------------------------------------------------------
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_TIMEOUT_S=4.0

# -------------------------------------------------------------
# WAKE / SLEEP — behouden uit oude .env (bron 1)
# -------------------------------------------------------------
# Fuzzy patterns, komma-gescheiden. hear.py matcht case-insensitive substring.
WAKE_PHRASE_PATTERNS=hoi anna nova,hallo anna nova,hoi anna,hey anna nova,anna nova,oké anna nova

SLEEP_PHRASES=slaap lekker,slaap zacht,welterusten,ga slapen,ga maar slapen,doe een dutje,tot morgen,slaap maar,genoeg geweest,stil nu,anna slapen,dag anna,doei anna

# -------------------------------------------------------------
# PRINTER (bouwstap 1 & 3, 's middags)
# -------------------------------------------------------------
PRINTER=geen              # mini | escpos | geen
PRINT_BREEDTE_PX=384      # meten in bouwstap 1 (58mm = 384; 80mm = 576)

# -------------------------------------------------------------
# SPREEKPLEK (bouwstap 7, 's middags)
# -------------------------------------------------------------
SPREEKPLEK_HOEK=0          # graden; 0 = recht voor
SPREEKPLEK_MARGE=30

# -------------------------------------------------------------
# AUDIO (bouwstap 6, 's middags)
# -------------------------------------------------------------
# AUDIO_INPUT_DEVICE, AUDIO_OUTPUT_DEVICE blijven uit bron 1
AUDIO_INPUT_DEVICE=
AUDIO_OUTPUT_DEVICE=default

PIPER_BIN=/home/anna/anna-nova/piper/piper/piper
PIPER_VOICE=/home/anna/anna-nova/piper/nl_BE-nathalie-medium.onnx

VOXTRAL_MODEL=voxtral-mini-latest
ASR_ENGINE=voxtral

# -------------------------------------------------------------
# TIMERS
# -------------------------------------------------------------
MAX_GESPREK_SEC=300        # 5 min → AFSLUITING

# -------------------------------------------------------------
# SLAPEND — foto-pijplijn (NIET ACTIEF in bouwplan v2)
# -------------------------------------------------------------
# Deze vars worden niet gelezen door anna.main; blijven hier voor
# toekomstige revival. Zie BOUWPLAN_V2_AANPAK.md sectie "Slapend laten
# bestaan".
# PHOTO_UPLOAD_ENABLED=false
# PHOTO_SFTP_HOST=
# PHOTO_SFTP_USER=
# PHOTO_SFTP_KEY=
# PHOTO_SFTP_REMOTE_PATH=
