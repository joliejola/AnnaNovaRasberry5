# Anna Nova — configuratie
# Pas aan en sla op als .env (de installer kopieert dit automatisch bij eerste install)

# -------------------------------------------------------------
# BREIN
# -------------------------------------------------------------
# local  → Phi-3 Mini via Ollama op deze Pi (standaard)
# cloud  → Mistral via La Plateforme (vereist MISTRAL_API_KEY)
BRAIN=local

OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=phi3:mini

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# -------------------------------------------------------------
# WAKKER WORDEN
# -------------------------------------------------------------
# Anna slaapt totdat ze deze zin hoort. Fuzzy match: variaties als
# "hoi anna", "hallo anna nova" worden ook geaccepteerd.
WAKE_PHRASE=hoi anna nova

# Wat Anna zegt bij wakker worden. Leeg laten = geen hoorbare bevestiging.
WAKE_ACK=Hm.

# Hoe lang Anna wakker blijft na laatste interactie (seconden) voor ze
# terugvalt in sluimer.
AWAKE_TIMEOUT=60

# -------------------------------------------------------------
# IN SLAAP VALLEN (expliciet commando)
# -------------------------------------------------------------
# Jolanda kan Anna altijd laten slapen door een van deze zinnen te zeggen.
# Komma-gescheiden lijst, fuzzy substring-match.
SLEEP_PHRASES=slaap lekker,slaap zacht,welterusten,ga slapen,ga maar slapen,ga rusten,doe een dutje,val maar in slaap,tot morgen,slaap maar,genoeg geweest,stil nu,anna slapen,dag anna,doei anna

# Wat Anna zegt vóór ze in sluimer gaat. Leeg laten = stil in slaap vallen.
SLEEP_ACK=Mmh. Welterusten.

# -------------------------------------------------------------
# AUDIO
# -------------------------------------------------------------
# Audio-devices
# Input (sounddevice/PortAudio) accepteert:
#   - leeg = systeemdefault (werkt vaak out-of-the-box met USB-mic/headset)
#   - een substring: "USB", "Blue Yeti", "Logitech", "ReSpeaker", ...
#   - een index (getal uit `python3 -c "import sounddevice as sd; print(sd.query_devices())"`)
# Standaard: leeg — pakt het systeemdefault-apparaat op.
AUDIO_INPUT_DEVICE=
# Output (aplay) accepteert een ALSA-string:
#   - "default"                         = ALSA default (goed voor meeste USB-speakers)
#   - "plughw:CARD=ReSpeaker,DEV=0"     = wanneer je de ReSpeaker hebt
#   - lijst alle opties: `aplay -L`
AUDIO_OUTPUT_DEVICE=default

# Spreekplek: hoek-range in graden (DoA van ReSpeaker)
# De spreekplek-cirkel staat recht voor Anna (0°), ±30° marge
SPEAK_ANGLE_CENTER=0
SPEAK_ANGLE_MARGIN=30

# true = alleen reageren als BEIDE spreekplek-checks positief zijn (DoA + camera)
# false = soepel: onbekende waardes tellen als "misschien" (standaard)
STRICT_SPEAK_PLACE=false

# Whisper
WHISPER_MODEL=small
WHISPER_LANGUAGE=nl

# Piper — Anna's stem (Jolanda's keuze: mls_7432)
PIPER_BIN=/home/pi/anna-nova/piper/piper/piper
PIPER_VOICE=/home/pi/anna-nova/piper/nl_NL-mls_7432-low.onnx

# -------------------------------------------------------------
# CAMERA / VISION (Hailo-8L)
# -------------------------------------------------------------
# true = camera-thread + Hailo face-detection; false = alleen audio
VISION_ENABLED=true

# Spreekplek-zone in frame-coordinaten (0-1 relatief)
# Default: centrum van beeld, 40% breed, van 20% tot 90% hoog
PLACE_X_MIN=0.30
PLACE_X_MAX=0.70
PLACE_Y_MIN=0.20
PLACE_Y_MAX=0.90

CAM_WIDTH=1280
CAM_HEIGHT=720

# Hailo model-paden (worden door de installer gedownload)
SCRFD_HEF=/home/pi/anna-nova/models/scrfd_2_5g.hef
FACE_ATTR_HEF=/home/pi/anna-nova/models/face_attr_resnet_v1_18.hef

# -------------------------------------------------------------
# BEELDEN-PIJPLIJN (optioneel — fase 9 van stappenplan)
# -------------------------------------------------------------
PHOTO_UPLOAD_ENABLED=false
PHOTO_SFTP_HOST=u123456.your-storagebox.de
PHOTO_SFTP_USER=u123456
PHOTO_SFTP_KEY=/home/pi/.ssh/id_ed25519

# -------------------------------------------------------------
# PERSONA + GEDRAG
# -------------------------------------------------------------
# Pad naar Anna's persona-markdown. Bewerk tijdens testen; na edits:
#   systemctl restart anna-nova
# De dag-arc (hoe ze zich vandaag voelt) staat los in SQLite persona_history
# en wordt elke nacht automatisch bijgewerkt door nachtslaap.py.
PERSONA_FILE=/home/pi/anna-nova/persona.md

ANNA_DB=/home/pi/anna-nova/anna.db

# -------------------------------------------------------------
# WEBPAGINA'S (lokaal scherm + galerij)
# -------------------------------------------------------------
# HTTP-server luistert op poort 8765. Open vanaf elke laptop/tablet in jullie
# wifi op http://anna.local:8765/ (gezicht) of http://anna.local:8765/gallery
WEB_DIR=/home/pi/anna-nova/web
PHOTOS_DIR=/home/pi/anna-nova/photos
HTTP_PORT=8765

# Mag Anna [STIL] antwoorden?
ALLOW_SILENCE=true

# Minimum stilte voor einde-beurt (seconden). 0.9 = snappy; 1.5 = beschouwend
END_OF_TURN_SILENCE=0.9
